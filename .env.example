# OpenRouter API Key for Agentic Graph AI
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Free Models in fallback order (comma-separated)
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free,qwen/qwen-2.5-72b-instruct:free,mistralai/mistral-small-24b-instruct-2501:free

# Server configuration
PORT=8000
HOST=0.0.0.0
